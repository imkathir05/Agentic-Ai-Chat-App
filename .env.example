# Database
# DB_ENGINE: sqlite | mysql | postgres
DB_ENGINE=sqlite

# MySQL (XAMPP)
# DB_NAME=agentic_ai_chat
# DB_USER=root
# DB_PASSWORD=
# DB_HOST=127.0.0.1
# DB_PORT=3306

# PostgreSQL (Supabase)
# DB_ENGINE=postgres
# DB_NAME=postgres
# DB_USER=postgres
# DB_PASSWORD=your-supabase-db-password
# DB_HOST=db.xxxxxxxxxxxx.supabase.co
# DB_PORT=5432
# DB_SSLMODE=require

# LLM provider: groq | gemini | huggingface
LLM_PROVIDER=groq

# Groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Hugging Face
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=Qwen/Qwen2.5-Coder-32B-Instruct

# Google OAuth (Sign in with Google)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# App settings
DEBUG=true
DJANGO_SECRET_KEY=dev-only-change-in-production
MAX_TOOL_ROUNDS=8
